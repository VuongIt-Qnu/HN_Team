# Khung thanh toan + van chuyen chung (HN_Team)
# Copy cac dong nay vao .env.local. Khong commit file .env.local len GitHub.
# Mac dinh ca hai deu la 'mock': khong goi hang that, khong co tien that.

# Provider thanh toan: mock | vnpay | momo (chi 'mock' duoc cai san hien tai)
PAYMENT_PROVIDER=mock
# Khoa rieng cho webhook, neu de trong thi route webhook chi dua vao xac thuc cua adapter
# PAYMENT_WEBHOOK_SECRET=doi-khoa-nay-tren-server

# Hang van chuyen: mock | ghn | ghtk | viettelpost (chi 'mock' duoc cai san hien tai)
SHIPPING_PROVIDER=mock
# SHIPPING_WEBHOOK_SECRET=doi-khoa-nay-tren-server

# Khi gan hang that, them khoa cua hang do o day, vi du:
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# GHN_TOKEN=
# GHN_SHOP_ID=
