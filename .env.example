# ============================================================
# Web App Quan ly Ban hang v5.0 - Bien moi truong mau
# Copy file nay thanh `.env.local` roi chinh sua gia tri.
# ============================================================

# Secret ky JWT (BAT BUOC doi khi len production, toi thieu 32 ky tu)
JWT_SECRET="hn-group-super-secret-key-change-me-in-production-2026"

# Thu muc goc API noi bo (khong can doi)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Thu muc luu anh hoan thien do NV Ky thuat tai len (mac dinh: <project>/uploads)
# Chi can doi khi muon luu ra o dia khac / NAS, vi du: D:\hn-group-uploads
# UPLOAD_DIR="C:\\hn-group-uploads"

# ------------------------------------------------------------
# PostgreSQL + Prisma (dung cho giai doan tich hop CSDL that)
# Giai doan hien tai ung dung chay bang Mock Data Layer nen
# gia tri nay chi can thiet khi chay `npm run db:push` / `db:seed`.
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hn_group?schema=public"
